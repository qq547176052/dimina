<!-- 人脸库列表页: 搜索/类型筛选/分页, 行操作(action sheet 编辑/删除), 顶部同步(直接触发), FAB 新增; 风格参考 page/index -->
<!--
  履历:
    2026-07-27 同步交互改直接触发: 顶部「同步」点击即开始同步(开始同步), 取消确认弹窗(原 syncOpen 弹窗已移除), 进度用 showLoading/toast 反馈
-->
<view class="page">
    <!-- 顶部栏: 标题 + 同步入口 -->
    <view class="topbar">
        <view class="topbar-left">
            <!-- <text class="topbar-title">人脸库</text> -->
            <text wx:if="{{cameraAlias}}" class="topbar-subtitle">{{cameraAlias}}</text>
        </view>
        <view class="topbar-actions">
            <view class="add-btn" bindtap="onAdd">
                <text class="add-btn-text">添加</text>
            </view>
            <view class="sync-btn" bindtap="开始同步">
                <text class="sync-btn-text">同步</text>
            </view>
        </view>
    </view>

    <!-- 搜索栏: 姓名 + 部门 + 类型筛选 -->
    <view class="searchbar">
        <input class="search-input" placeholder="搜索姓名" value="{{filters.name}}" data-field="name" bindinput="onFilterInput"/>
        <input class="search-input" placeholder="部门" value="{{filters.department}}" data-field="department" bindinput="onFilterInput"/>
        <picker mode="selector" range="{{faceLibraryFilterOptions}}" range-key="label" value="{{filterTypeIndex}}" bindchange="onFilterTypePick">
            <view class="search-picker">{{faceLibraryFilterOptions[filterTypeIndex].label}}</view>
        </picker>
        <view class="search-go" bindtap="applyFilter">搜索</view>
    </view>

    <scroll-view scroll-y="{{!swipeLock}}" class="records-scroll" lower-threshold="120" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore" bindscroll="onListScroll">

        <view wx:if="{{loading && !list.length}}" class="status-tip">加载中...</view>
        <view wx:elif="{{loadError && !list.length}}" class="status-tip status-error" bindtap="reloadList">{{loadError}}（点击重试）</view>
        <view wx:elif="{{!loading && !list.length}}" class="status-tip">暂无人员</view>

        <view class="record-list" bindtap="onListTap">
            <view class="swipe-item" wx:for="{{list}}" wx:key="pid" data-name="{{item.name}}" data-pid="{{item.pid}}"
                  bindtouchstart="onSwipeTouchStart" bindtouchmove="onSwipeTouchMove"
                  bindtouchend="onSwipeTouchEnd" bindtouchcancel="onSwipeTouchEnd" bindtap="onSwipeTap">
                <view class="swipe-actions {{item.translateX < 0 ? 'open' : ''}}">
                    <view class="swipe-btn del" data-name="{{item.name}}" data-pid="{{item.pid}}" catchtap="确认删除">删除</view>
                </view>
                <view class="swipe-content {{swipeLock ? 'no-anim' : ''}}" style="transform: translateX({{item.translateX}}px);">
                    <image class="card-avatar" src="{{item.faceDisplayUrl || placeholderAvatar}}" mode="aspectFill"/>
                    <view class="card-body">
                        <view class="card-name">{{item.name || '-'}}</view>
                        <view class="card-row"><text class="card-label">工号</text><text class="card-value">{{item.employeeNo || '-'}}</text></view>
                        <view class="card-row"><text class="card-label">部门</text><text class="card-value">{{item.department || '-'}}</text></view>
                    </view>
                    <view class="card-tag" style="background:{{item.faceLibraryColor}}">{{item.faceLibraryLabel}}</view>
                </view>
            </view>
        </view>

        <view wx:if="{{loadingMore}}" class="status-tip status-footer">加载中...</view>
        <view wx:elif="{{list.length && hasMore}}" class="status-tip status-footer">上拉加载更多</view>
        <view wx:elif="{{list.length}}" class="status-tip status-footer">共 {{total}} 条</view>
    </scroll-view>

</view>
