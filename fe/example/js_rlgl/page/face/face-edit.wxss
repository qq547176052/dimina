/* 人脸库新增/编辑表单页 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}
.form-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 照片 */
.photo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 28rpx;
}
.photo-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #eee;
  border: 1rpx solid #e0e0e0;
}
.photo-tip {
  margin-top: 14rpx;
  font-size: 13px;
  color: #07c160;
}

/* 字段 */
.form-field {
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.field-label {
  display: block;
  font-size: 13px;
  color: #555;
  margin-bottom: 10rpx;
}
.req {
  color: #e64340;
  margin-left: 4rpx;
}
.field-input,
.field-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  font-size: 14px;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}
.field-picker::after { content: ''; }

.form-spacer {
  height: 20rpx;
}

/* 底部操作栏 */
.action-bar {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}
.action-cancel,
.action-submit {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 15px;
  border-radius: 12rpx;
  border: none;
  margin: 0;
  padding: 0;
}
.action-cancel::after,
.action-submit::after { border: none; }
.action-cancel {
  background: #f2f3f5;
  color: #666;
}
.action-submit {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-weight: 600;
}
