/* 人脸库列表页: 自定义样式, 复用 page/index 视觉语言 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}
.records-scroll {
  flex: 1;
  min-height: 0;
}

/* ---- 顶部栏 ---- */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.topbar-title {
  font-size: 17px;
  font-weight: 700;
  color: #1a1a1a;
}
.topbar-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.topbar-subtitle {
  margin-top: 4rpx;
  font-size: 12px;
  color: #999;
  font-weight: 400;
}
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.add-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 26rpx;
  background: #fff;
  border: 1rpx solid #07c160;
  border-radius: 28rpx;
}
.add-btn-text {
  font-size: 13px;
  color: #07c160;
}
.sync-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 26rpx;
  background: #07c160;
  border-radius: 28rpx;
}
.sync-btn-text {
  font-size: 13px;
  color: #fff;
}

/* ---- 列表项: 左滑删除(参考 admin_app/page/index) ---- */
.swipe-item {
  position: relative;
  overflow: hidden;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 100%;
  display: flex;
  flex-direction: row;
  opacity: 0;
  transition: opacity 0.18s ease;
  pointer-events: none;
}
.swipe-actions.open {
  opacity: 1;
  pointer-events: auto;
}
.swipe-content {
  position: relative;
  z-index: 1;
  width: 100%;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  transform: translateX(0);
  transition: transform 0.2s ease;
  will-change: transform;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.swipe-content.no-anim {
  transition: none;
}
.swipe-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
}
.swipe-btn.del {
  background: #e64340;
}

/* ---- 搜索栏 ---- */
.searchbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  font-size: 14px;
  background: #fafafa;
  box-sizing: border-box;
}
.search-picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  font-size: 14px;
  background: #fafafa;
  white-space: nowrap;
}
.search-go {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  background: #07c160;
  color: #fff;
  border-radius: 10rpx;
  font-size: 14px;
}

/* ---- 状态提示 ---- */
.status-tip {
  text-align: center;
  color: #999;
  font-size: 13px;
  padding: 40px 0;
}
.status-error { color: #e64340; }
.status-footer { padding: 16px 0 8px; }

/* ---- 列表 ---- */
.record-list {
  padding: 10px 12px 20px;
}
.card-avatar {
  width: 80px;
  height: 80px;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}
.card-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.card-name {
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.card-row {
  display: flex;
  align-items: center;
  font-size: 12px;
  line-height: 1.9;
  color: #888;
}
.card-label {
  flex-shrink: 0;
  color: #bbb;
  margin-right: 6rpx;
}
.card-value {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 12px;
  color: #fff;
  align-self: center;
}

/* ---- 弹窗(同步) ---- */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  touch-action: none;
}
.modal-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
}
.modal-title {
  text-align: center;
  font-size: 17px;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.sync-status {
  text-align: center;
  font-size: 15px;
  padding: 16rpx 0;
  color: #555;
}
.sync-0 { color: #07c160; }
.sync-2 { color: #e64340; }
.sync-loading {
  text-align: center;
  font-size: 13px;
  color: #999;
  padding-bottom: 16rpx;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 15px;
  border-radius: 12rpx;
  border: none;
  margin: 0;
  padding: 0;
}
.modal-btn::after { border: none; }
.modal-btn-cancel {
  background: #f2f3f5;
  color: #666;
}
.modal-btn-submit {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  font-weight: 600;
}
